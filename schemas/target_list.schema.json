{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeai.local/schemas/target-list-v2.schema.json",
  "title": "Edge AI机器人挑战赛Task 1目标列表",
  "description": "位姿约定见docs/marker_and_rescue_geometry.md。救援区数量与rescue_geometry.version的一致性由tools/validate_project_contracts.py和导出器做语义检查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "frozen_at",
    "frame_id",
    "map",
    "rescue_geometry",
    "targets"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "revision": {
      "description": "冻结时的target_revision；Task 1未发现任何目标时为0。",
      "type": "integer",
      "minimum": 0
    },
    "frozen_at": { "type": "string", "format": "date-time" },
    "frame_id": { "const": "map" },
    "map": { "$ref": "#/$defs/mapMetadata" },
    "rescue_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": {
          "description": "生成救援区所用几何规则版本；官方规则未公布且处于比赛模式时为null，此时所有rescue_zones为空。",
          "type": ["string", "null"],
          "minLength": 1
        },
        "source": { "enum": ["official", "development", null] }
      }
    },
    "targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "yaw": {
      "type": "number",
      "minimum": -3.141592653589793,
      "exclusiveMaximum": 3.141592653589793
    },
    "mapMetadata": {
      "description": "规则5.4A要求的地图元数据；数值必须与map.yaml一致。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_id",
        "revision",
        "frame_id",
        "yaml",
        "yaml_sha256",
        "image",
        "image_sha256",
        "resolution_m",
        "origin",
        "width_cells",
        "height_cells"
      ],
      "properties": {
        "map_id": { "$ref": "#/$defs/nonEmptyString" },
        "revision": { "type": "integer", "minimum": 1 },
        "frame_id": { "const": "map" },
        "yaml": { "$ref": "#/$defs/relativePath" },
        "yaml_sha256": { "$ref": "#/$defs/sha256" },
        "image": { "$ref": "#/$defs/relativePath" },
        "image_sha256": { "$ref": "#/$defs/sha256" },
        "resolution_m": { "type": "number", "exclusiveMinimum": 0 },
        "origin": {
          "description": "地图图像左下角像素在map坐标系中的位姿，与map.yaml的origin相同。",
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "yaw"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "yaw": { "$ref": "#/$defs/yaw" }
          }
        },
        "width_cells": { "type": "integer", "minimum": 1 },
        "height_cells": { "type": "integer", "minimum": 1 }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "quaternion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "w"],
      "properties": {
        "x": { "type": "number", "minimum": -1, "maximum": 1 },
        "y": { "type": "number", "minimum": -1, "maximum": 1 },
        "z": { "type": "number", "minimum": -1, "maximum": 1 },
        "w": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "orientation"],
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "orientation": { "$ref": "#/$defs/quaternion" }
      }
    },
    "rescueZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "pose"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 1 },
        "pose": { "$ref": "#/$defs/pose" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "marker_id",
        "target_type",
        "marker_pose",
        "marker_yaw_rad",
        "covariance",
        "rescue_zones",
        "observation_count",
        "confidence",
        "observed_by",
        "eligible_for_basic_rescue"
      ],
      "properties": {
        "target_id": { "$ref": "#/$defs/nonEmptyString" },
        "marker_id": { "type": "integer", "minimum": 0 },
        "target_type": { "enum": ["normal", "cooperative"] },
        "marker_pose": { "$ref": "#/$defs/pose" },
        "marker_yaw_rad": { "$ref": "#/$defs/yaw" },
        "covariance": {
          "description": "6x6行优先协方差，顺序为x、y、z、roll、pitch、yaw。",
          "type": "array",
          "minItems": 36,
          "maxItems": 36,
          "items": { "type": "number" }
        },
        "rescue_zones": {
          "type": "array",
          "items": { "$ref": "#/$defs/rescueZone" }
        },
        "observation_count": { "type": "integer", "minimum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "observed_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "eligible_for_basic_rescue": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "target_type": { "const": "normal" } } },
          "then": {
            "properties": { "rescue_zones": { "maxItems": 1 } }
          }
        },
        {
          "if": { "properties": { "target_type": { "const": "cooperative" } } },
          "then": {
            "properties": {
              "rescue_zones": {
                "anyOf": [
                  { "maxItems": 0 },
                  { "minItems": 2, "maxItems": 2 }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
