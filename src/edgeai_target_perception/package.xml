<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>edgeai_target_perception</name>
  <version>0.0.0</version>
  <description>ArUco target detection and timestamp-aware multi-robot target fusion.</description>
  <maintainer email="huangzc333@gmail.com">hzc333</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>edgeai_common</depend>
  <depend>edgeai_robot_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <test_depend>geometry_msgs</test_depend>
  <depend>cv_bridge</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
